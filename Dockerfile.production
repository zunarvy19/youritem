FROM php:8.4-fpm-alpine AS php-base

RUN apk add --no-cache icu-libs libpq libzip \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS icu-dev libzip-dev postgresql-dev \
    && docker-php-ext-install -j"$(nproc)" bcmath intl opcache pcntl pdo_pgsql zip \
    && apk del .build-deps

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

WORKDIR /var/www/html

FROM php-base AS build

COPY --from=node:22-alpine /usr/local/ /usr/local/
COPY . .

RUN composer install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --optimize-autoloader \
    && npm ci \
    && npm run build \
    && rm -rf node_modules \
    && rm -f public/hot

FROM php-base AS app

COPY --from=build --chown=www-data:www-data /var/www/html /var/www/html
COPY docker/production/php.ini /usr/local/etc/php/conf.d/production.ini

RUN mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs \
    && chown -R www-data:www-data storage bootstrap/cache

EXPOSE 9000

CMD ["php-fpm", "-F"]

FROM nginx:1.27-alpine AS web

COPY docker/production/app-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /var/www/html/public /var/www/html/public

EXPOSE 80
